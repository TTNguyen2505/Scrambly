%%!
% @brief Configures 4pt symmetric cell padding and vertical centering for tables.
% @details Overrides array strut mechanics to enforce top and bottom cell padding
%          across single-line and multi-line paragraph cells.
\renewcommand\tabularxcolumn[1]{m{#1}}

\newlength{\celltoppadding}
\newlength{\cellbottompadding}
\setlength{\celltoppadding}{4pt}
\setlength{\cellbottompadding}{4pt}

\setlength{\extrarowheight}{\celltoppadding}

\def\@arstrut{%
    \vrule \@height\dimexpr\ht\strutbox+\celltoppadding\relax
           \@depth\dimexpr\dp\strutbox+\cellbottompadding\relax
           \@width\z@
}

\def\@finalstrut#1{%
    \unskip
    \ifhmode \nobreak
    \else
        \ifnum\lastnodetype>\m@ne
            \vskip-\baselineskip
        \fi
    \fi
    \vrule\@width\z@\@height\z@\@depth\dimexpr\dp\strutbox+\cellbottompadding\relax
}

\setlength{\tabcolsep}{5pt}

\newcolumntype{L}[1]{>{\fontsize{13pt}{16pt}\selectfont\raggedright\arraybackslash}m{#1}}
\newcolumntype{C}[1]{>{\fontsize{13pt}{16pt}\selectfont\centering\arraybackslash}m{#1}}
\newcolumntype{R}[1]{>{\fontsize{13pt}{16pt}\selectfont\raggedleft\arraybackslash}m{#1}}
\newcolumntype{Y}{>{\fontsize{13pt}{16pt}\selectfont\raggedright\arraybackslash}X}

