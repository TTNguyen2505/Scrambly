%%!
% @brief Renders the unnumbered appendix section divider without forcing a page break before the first sub-appendix.
% @param #1 Section title (e.g., "PHỤ LỤC").
\newcommand{\appendixmaintitle}[1]{%
    \clearpage
    \vspace*{12pt}%
    {\centering\fontsize{14pt}{17pt}\selectfont\bfseries\MakeUppercase{#1}\par}%
    \vspace{4pt}%
    \addcontentsline{toc}{chapter}{#1}%
    \let\orig@clearpage\clearpage
    \let\orig@cleardoublepage\cleardoublepage
    \def\clearpage{\let\clearpage\orig@clearpage\let\cleardoublepage\orig@cleardoublepage}%
    \def\cleardoublepage{\let\clearpage\orig@clearpage\let\cleardoublepage\orig@cleardoublepage}%
}

%%!
% @brief Redefines the appendix environment to format sub-appendix titles and TOC entries.
\let\orig@appendix\appendix
\renewcommand{\appendix}{%
    \orig@appendix
    \titleformat{\chapter}[block]
    {\fontsize{13pt}{16pt}\selectfont\bfseries}
    {Phụ lục \thechapter.\enspace}
    {0pt}
    {}
    \titlespacing*{\chapter}{0pt}{16pt}{4pt}

    \titlecontents{chapter}
    [0pt]
    {\vspace{2pt}\fontsize{13pt}{16pt}\selectfont\bfseries}
    {Phụ lục \thecontentslabel.\enspace}
    {}
    {\titlerule*[0.5pc]{.}\contentspage}
    [\vspace{2pt}]
}

