%%!
% @brief Registers an author by index, full name, student ID, assigned task, and contribution percentage.
% @param #1 Author index / ID (e.g., 1, 2, 3...).
% @param #2 Full name of the student.
% @param #3 Student ID number (MSSV).
% @param #4 Assigned task / responsibilities.
% @param #5 Contribution percentage.
\newcommand{\addauthor}[5]{%
    \ifnum#1>\value{authorcount}%
        \setcounter{authorcount}{#1}%
    \fi
    \expandafter\gdef\csname authorname#1\endcsname{#2}%
    \expandafter\gdef\csname authorid#1\endcsname{#3}%
    \expandafter\gdef\csname authortask#1\endcsname{#4}%
    \expandafter\gdef\csname authorcontrib#1\endcsname{#5}%
}

%%!
% @brief Getters for author information by author index / ID.
% @param #1 Author index / ID.
\newcommand{\getauthorname}[1]{%
    \ifcsname authorname#1\endcsname
        \csname authorname#1\endcsname
    \fi
}

\newcommand{\getauthorid}[1]{%
    \ifcsname authorid#1\endcsname
        \csname authorid#1\endcsname
    \fi
}

\newcommand{\getauthortask}[1]{%
    \ifcsname authortask#1\endcsname
        \csname authortask#1\endcsname
    \fi
}

\newcommand{\getauthorcontrib}[1]{%
    \ifcsname authorcontrib#1\endcsname
        \csname authorcontrib#1\endcsname
    \fi
}

\newlength{\authorlabelwidth}
\setlength{\authorlabelwidth}{5.4cm}

%%!
% @brief Recursively renders the list of authors in two-column alignment.
\newcommand{\@printauthors}{%
    \ifnum\value{authorloopidx}<\value{authorcount}%
        \stepcounter{authorloopidx}%
        \ifnum\value{authorloopidx}=1
            \noindent\makebox[\authorlabelwidth][l]{Sinh viên thực hiện:}%
            \parbox[t]{\dimexpr\textwidth-\authorlabelwidth\relax}{%
                \csname authorid\the\value{authorloopidx}\endcsname\space\textendash\space\csname authorname\the\value{authorloopidx}\endcsname
            }\par
        \else
            \noindent\makebox[\authorlabelwidth][l]{}%
            \parbox[t]{\dimexpr\textwidth-\authorlabelwidth\relax}{%
                \csname authorid\the\value{authorloopidx}\endcsname\space\textendash\space\csname authorname\the\value{authorloopidx}\endcsname
            }\par
        \fi
        \expandafter\@printauthors
    \fi
}

%%!
% @brief Renders the supervisor, author list, class, and cohort block on the cover page.
\newcommand{\renderauthorblock}{%
    \begingroup
    \fontsize{14pt}{20pt}\selectfont
    \ifx\thesupervisor\empty\relax\else
        \noindent\makebox[\authorlabelwidth][l]{Giảng viên hướng dẫn:}%
        \parbox[t]{\dimexpr\textwidth-\authorlabelwidth\relax}{\thesupervisor}\par
    \fi
    \setcounter{authorloopidx}{0}%
    \@printauthors
    \ifx\thestudentclass\empty\relax\else
        \noindent\makebox[\authorlabelwidth][l]{Lớp:}%
        \parbox[t]{\dimexpr\textwidth-\authorlabelwidth\relax}{\thestudentclass}\par
    \fi
    \ifx\thecohort\empty\relax\else
        \noindent\makebox[\authorlabelwidth][l]{Khoá:}%
        \parbox[t]{\dimexpr\textwidth-\authorlabelwidth\relax}{\thecohort}\par
    \fi
    \endgroup
}

