     /S /P
     /Pg 284 0 R
     /Type /StructElem
  >>
endobj

298 0 obj
  << /ActualText (Stamps\054 emotes\054 and high\055fives\n\nVisual representations of feedback and reactions can be more effective than text\056 Stamps\056  emotes and high\055fives used to do just this\041\n\nStamps \055\076 Stamps can be placed in a file for visual feedback\056 These are great for both live and async collaboration\056\n\n\n\n\nEmotes \055\076 Emotes are temporary and great for live\054 energetic reactions with others who are active in a file\056\n\n\n\n\nHighfives \055\076 High fives is a fun way to celebrate achievements\054 greet others\054 or capture someone\047s attention in a file\056\n\n)
     /K [ 7 ]
     /P 299 0 R
     /Pg 284 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

